---
import { render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import PageHeader from '../../components/PageHeader.astro'
import PlaceholderNotice from '../../components/PlaceholderNotice.astro'
import Prose from '../../components/Prose.astro'
import Base from '../../layouts/Base.astro'
import { getLearnEntries, isPlaceholder, resolveReferences } from '../../lib/content'
import { formatLongDate } from '../../lib/site'

export const getStaticPaths = (async () => {
	const entries = await getLearnEntries()
	return entries.map((note) => ({ params: { slug: note.id }, props: { note } }))
}) satisfies GetStaticPaths

const { note } = Astro.props
const { data } = note
const { Content } = await render(note)
const authors = await resolveReferences(data.authors)

const KIND = {
	note: 'Note',
	guide: 'Guide',
	recording: 'Recording',
	'reading-list': 'Reading list',
} as const
const LEVEL = { intro: 'Intro', intermediate: 'Intermediate', advanced: 'Advanced' } as const
---

<Base title={data.title} section="/learn" description={data.summary}>
	<PageHeader n="04" eyebrow={KIND[data.kind]} title={data.title} standfirst={data.summary} />

	<section class="section section--open grid">
		<div class="rail" aria-hidden="true"></div>

		<div class="col-lead">
			<p class="m-data note__meta">
				{formatLongDate(data.publishDate)}
				<span aria-hidden="true"> · </span>{LEVEL[data.level]}
				{data.minutes && <><span aria-hidden="true"> · </span>{data.minutes} min</>}
				{authors.length > 0 && (
					<><span aria-hidden="true"> · </span>{authors.map((a) => a.data.name).join(', ')}</>
				)}
			</p>

			{isPlaceholder(note) && <PlaceholderNotice />}
			<Prose><Content /></Prose>

			{
				data.recordingUrl && (
					<a class="link-action m-button note__recording" href={data.recordingUrl} rel="noopener" target="_blank">
						Watch the recording <span aria-hidden="true">↗</span>
					</a>
				)
			}
		</div>
	</section>
</Base>

<style>
	.note__meta {
		margin-block-end: 2rem;
		padding-block-end: 1rem;
		border-block-end: 1px solid var(--rule);
		color: var(--ink-3);
	}

	.note__recording {
		margin-block-start: 2.5rem;
	}
</style>
