---
import EmptyState from '../../components/EmptyState.astro'
import LearnRow from '../../components/LearnRow.astro'
import PageHeader from '../../components/PageHeader.astro'
import Plate from '../../components/Plate.astro'
import Base from '../../layouts/Base.astro'
import { getLearnEntries } from '../../lib/content'

const entries = await getLearnEntries()
---

<Base
	title="Learn"
	section="/learn"
	description="Notes, guides and recordings from QairuHub sessions. Written up so people who missed a Friday can still follow along."
>
	<PageHeader
		n="04"
		eyebrow="Learn"
		title="Notes from the sessions."
		standfirst="Every Friday session gets written up afterwards. The notes are for people who were not there, so they assume nothing and link to what they reference."
	/>

	<Plate />

	<section class="section grid">
		<div class="rail" aria-hidden="true"><span class="dn">04</span></div>
		<div class="well">
			{
				entries.length > 0 ? (
					<div class="record">
						{entries.map((note) => (
							<LearnRow note={note} headingLevel={2} />
						))}
					</div>
				) : (
					<EmptyState
						title="No notes published yet."
						body="Notes appear here after the first session is written up."
						actionLabel="See what is on"
						actionHref="/events"
					/>
				)
			}
		</div>
	</section>
</Base>
