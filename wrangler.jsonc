{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "qairuhub-website",
	"main": "@astrojs/cloudflare/entrypoints/server",

	// Derived from the locally installed workerd. Do not hand-edit this to a
	// date newer than your workerd build — the dev server will refuse to start.
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["global_fetch_strictly_public"],

	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},

	"observability": {
		"enabled": true
	},

	// NOTE: custom domains are deliberately NOT configured here.
	//
	// @astrojs/cloudflare regenerates the wrangler config into dist/server at
	// build time and deploy uses that file, which carries "triggers": {} and no
	// routes — anything declared here is silently dropped. The domains are
	// attached to the Worker in the Cloudflare dashboard instead, where they
	// persist across deploys. See docs/ARCHITECTURE.md.

	// Form submissions: applications, RSVPs, contact messages.
	// Created in EEUR, which is the closest region to Astana.
	// Migrations live in ./migrations — apply with `pnpm db:migrate:remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "qairuhub",
			"database_id": "531fd0e2-6685-42ff-aab3-2b0936234d6a",
			"migrations_dir": "migrations"
		}
	]

	// SESSION (KV) and IMAGES bindings are provisioned automatically by
	// @astrojs/cloudflare — they do not need declaring here.
	//
	// There is deliberately no R2 bucket yet. Images are optimised at build
	// time from src/assets, so nothing reads from object storage. Add one when
	// there is original media that needs to outlive a build.
}
