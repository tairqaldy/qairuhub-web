{
	"name": "qairuhub-website",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:bg": "astro dev --background",
		"dev:stop": "astro dev stop",
		"dev:logs": "astro dev logs",
		"build": "astro build",
		"preview": "astro preview",
		"typecheck": "astro check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"guard:attribution": "node scripts/check-no-attribution.mjs",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run guard:attribution && pnpm run test:run",
		"cf:types": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply qairuhub --local",
		"db:migrate:remote": "wrangler d1 migrations apply qairuhub --remote",
		"deploy:prod": "astro build && wrangler deploy",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.0",
		"@astrojs/markdown-satteri": "^0.4.0",
		"@astrojs/mdx": "^8.0.0",
		"@astrojs/react": "^6.0.5",
		"@astrojs/sitemap": "^3.7.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"astro": "^7.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.129.0"
	},
	"private": true,
	"packageManager": "pnpm@10.30.3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"@biomejs/biome",
			"workerd",
			"lefthook"
		]
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.12",
		"@playwright/test": "^1.63.0",
		"lefthook": "^2.1.12",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"description": "QairuHub — the student-driven builder and AI community at QAIRU, Astana."
}
