# Copy to .env for local development. NEVER commit .env.
# Production values are set with `wrangler secret put <NAME>` — not here.

# --- Cloudflare Turnstile (anti-spam) -------------------------------------
# These are Cloudflare's documented ALWAYS-PASSES test keys. Safe for local dev.
PUBLIC_TURNSTILE_SITEKEY="1x00000000000000000000AA"
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"

# --- Transactional email (Resend) -----------------------------------------
RESEND_API_KEY=""
# Where application notifications are sent.
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""

# --- Telegram notifications ------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Optional automation webhook ------------------------------------------
N8N_WEBHOOK_URL=""

# --- Site ------------------------------------------------------------------
# Only read when it is a real environment variable, not from this file:
# astro.config.mjs is evaluated before Astro loads .env. Set it in the shell or
# in CI if you need to build against a different origin.
#   PUBLIC_SITE_URL=https://staging.example PNPM run build
PUBLIC_SITE_URL="https://qairuhub.com"
